PORT=8080
HOST=0.0.0.0

DISPATCHER_URL=
DISPATCHER_API_KEY=
DISPATCHER_CONNECTION_TIMEOUT_MS=5000
DISPATCHER_REQUEST_TIMEOUT_MS=30000
DISPATCHER_VERIFICATION_TIMEOUT_MS=120000
DISPATCHER_POLL_INTERVAL_MS=1000

POSTGRES_URL=postgresql://dataset_delivery:change-me@localhost:5432/dataset_delivery
# Optional Compose-only override. The default uses the `postgres` service hostname.
# COMPOSE_POSTGRES_URL=postgresql://dataset_delivery:change-me@postgres:5432/dataset_delivery
POSTGRES_SCHEMA=dataset_delivery

# The service runs a sync every 15 minutes by default.
SYNC_ENABLED=true
SYNC_SCHEDULE=*/15 * * * *

# Optional ITB validator URL (required when VALIDATION_MODE=itb).
METADATA_VALIDATOR_URL=https://health-data-itb-rdf-validator.data.health.europa.eu/shacl/ehds/api/validate

# Required to start syncs through the API. Minimum 32 characters.
# Leave empty to disable API controls; scheduled syncs still run.
CONTROL_API_TOKEN=

# Default for scheduled runs and sync API requests without a per-run override.
# validate_only, validate_and_sync, or sync_only (default).
OPERATION_MODE=sync_only
# Exact trusted Release 8 validator profile (include a ruleset version/hash).
# Leave empty until a compatible validator applies the full agreed rules.
RELEASE8_VALIDATION_PROFILE=

# shacl: bundled pySHACL engine; no HTTP service required.
# itb: external ITB JSON request + SHACL JSON-LD response.
VALIDATION_MODE=shacl
# Optional version; requires {version} in the selected shapes path or API URL.
# Example: release-8 with validator/shapes/{version}/shapes.ttl
# API: use an API URL template documented by your validator deployment.
# VALIDATION_VERSION=release-8
# Trusted, self-contained Turtle rules. No production rules are enabled by default.
METADATA_VALIDATOR_SHAPES_FILE=
METADATA_VALIDATOR_PYTHON=.venv/bin/python
METADATA_VALIDATOR_VALIDATION_TYPE=auto
# Optional ruleset identifier; blank generates a shapes/endpoint hash.
METADATA_VALIDATOR_PROFILE=
METADATA_VALIDATOR_TIMEOUT_MS=120000

# Full catalogue RDF: datasets and their linked metadata are extracted locally.
DATASET_CATALOGUE_RDF_URL=https://catalogue.portal.gdi.lu/catalog.rdf
