{
  "name": "national-dispatcher-integration-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run format && npm run lint && npm run type-check && npm run test",
    "test:release8": ".venv/bin/python validator/build_release8.py && TEST_RELEASE8=true vitest run tests/integration/release8.test.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "jsonld": "^9.0.0",
    "pg": "^8.16.3",
    "rdfxml-streaming-parser": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  }
}
